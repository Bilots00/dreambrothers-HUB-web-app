# ── POD Partners routing (Cloudflare Worker "smistamento-ordini") ──
# URL del worker che smista gli ordini EU non-Gelato verso Prodigi/Printumo
VITE_SMISTAMENTO_URL=https://smistamento-ordini.andrea-bilotta00.workers.dev
# Chiave per autorizzare POST /config (inviata nell'header X-CONFIG-KEY)
VITE_SMISTAMENTO_CONFIG_KEY=your-config-key-here

# ── Printify: pubblicazione automatica dei design approvati ──
# Token da Printify → Account → Connections → API tokens (scope: shops.manage, products.write).
# Senza questo, approvare un design registra un errore di pubblicazione invece di creare il prodotto.
PRINTIFY_API_TOKEN=your-printify-token-here
# Ricarico sul costo di stampa (default 3.4 → margine sopra il 70%).
# PRINTIFY_MARKUP=3.4
# Blueprint/provider: l'apparel ha default validati (Gildan 5000 + Printful EU).
# Per la wall art, se non impostati, vengono cercati a catalogo.
# PRINTIFY_BLUEPRINT_APPAREL=6
# PRINTIFY_PROVIDER_APPAREL=410
# PRINTIFY_BLUEPRINT_WALLART=
# PRINTIFY_PROVIDER_WALLART=
